<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan arahkan ulang jika file atau direktori benar-benar ada fisik di server
  # (seperti asset /assets/..., gambar, atau file api_alumni.php)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Semua route lainnya diarahkan ke index.html (SPA React)
  RewriteRule ^ index.html [L]
</IfModule>
